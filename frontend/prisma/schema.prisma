// Prisma 7's generator. `output` must match the import in src/lib/prisma.js.
generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

// Prisma 7 no longer accepts `url` here. The connection string for Migrate
// lives in prisma.config.ts; the runtime client gets a driver adapter.
datasource db {
  provider = "postgresql"
}



model Message {
  id String @id @default(uuid())
  name    String
  email   String
  country String
  message String 
  subject String?
  company String?
  createdAt DateTime @default(now())
  @@index([createdAt(sort: Desc)])
  @@index([email])
  @@map("messages")
}

model Quote {
  id String @id @default(uuid())
  firstName String @map("first_name")
  lastName  String @map("last_name")
  email     String
  phone     String
  company   String
  country   String
  message   String 
  createdAt DateTime @default(now())
  @@index([createdAt(sort: Desc)])
  @@index([email])
  @@map("quotes")
}

model Subscriber {
  id String @id @default(uuid())
  // Unique so the list cannot hold the same person twice. Re-subscribing is
  // an upsert that leaves the original createdAt alone — the date someone
  // first joined is the useful one, and a repeat submission is not a new
  // subscriber. It also means a double-click cannot create two rows.
  email     String   @unique
  createdAt DateTime @default(now())
  @@index([createdAt(sort: Desc)])
  @@map("subscribers")
}
